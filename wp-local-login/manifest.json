{
  "manifest_version": 3,
  "name": "WP Local Login",
  "version": "1.0.0",
  "description": "One-click (or automatic) WordPress login on *.localhost dev sites.",
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "WP Local Login settings"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.localhost/*",
        "https://*.localhost/*",
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
